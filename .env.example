# Copy this file to .env and adjust if needed.
# .env is gitignored.

# Path to the SQLite database file. The Docker setup uses /data which is
# bind-mounted from ./data on the host. For local (no-Docker) runs you can
# point this anywhere writable, e.g. ./re-server.db.
SQLITE_PATH=/data/re-server.db

# Path the loader uses to find the CSV. Defaults to /data/nsw_property_data.csv
# inside the loader container; for non-Docker runs, override to a local path.
RE_CSV_PATH=/data/nsw_property_data.csv
